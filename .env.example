# ─────────────────────────────────────────────────────────────────────────────
# Cashora — Environment Variable Template
# Copy this to .env and fill in all required values before running locally.
# NEVER commit a populated .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=local
APP_VERSION=0.1.0-dev

# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_PORT=8080
BACKEND_MANAGEMENT_PORT=8081
SPRING_PROFILES_ACTIVE=local

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cashora_dev
POSTGRES_USER=cashora_app
POSTGRES_PASSWORD=change_me_local
POSTGRES_POOL_MIN=5
POSTGRES_POOL_MAX=20

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── Apache Kafka ─────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=cashora-backend-local
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# ─── HashiCorp Vault ──────────────────────────────────────────────────────────
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token
VAULT_NAMESPACE=

# ─── JWT / Auth ───────────────────────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_EXPIRY_SECONDS=3600
JWT_REFRESH_EXPIRY_SECONDS=604800

# ─── OPA (Open Policy Agent) ──────────────────────────────────────────────────
OPA_BASE_URL=http://localhost:8181

# ─── Payment Gateway (Xendit) ─────────────────────────────────────────────────
XENDIT_API_KEY=
XENDIT_WEBHOOK_SECRET=
XENDIT_ENVIRONMENT=sandbox

# ─── QRIS TUNTAS ──────────────────────────────────────────────────────────────
BI_SNAP_CLIENT_ID=
BI_SNAP_CLIENT_SECRET=
BI_SNAP_PARTNER_ID=
BI_SNAP_CHANNEL_ID=
BI_SNAP_BASE_URL=https://sandbox.bi.go.id

# ─── Delivery Aggregator APIs ─────────────────────────────────────────────────
GOFOOD_API_KEY=
GRABFOOD_API_KEY=
SHOPEEFOOD_API_KEY=

# ─── Notification Services ────────────────────────────────────────────────────
FCM_SERVER_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# ─── Web Dashboard ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APP_ENV=local
NEXTAUTH_SECRET=change_me_local
NEXTAUTH_URL=http://localhost:3000

# ─── Feature Flags (FlagD) ────────────────────────────────────────────────────
FLAGD_HOST=localhost
FLAGD_PORT=8013

# ─── Observability ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=cashora-backend
GRAFANA_TEMPO_URL=http://localhost:3200

# ─── Object Storage (S3-compatible) ──────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=cashora-dev
S3_REGION=ap-southeast-1
